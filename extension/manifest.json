{
  "manifest_version": 3,
  "name": "Toolverse Video & Media Downloader",
  "version": "1.0.0",
  "description": "Download video and audio from supported web platforms and manage HD downloads with Toolverse.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toolverse Media Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "https://toolverse-yt-api-cyg1.onrender.com/*",
    "https://toolversee.pages.dev/*",
    "https://i.ytimg.com/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}

