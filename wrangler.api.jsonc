{
  "name": "Toolverse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "Toolverse-db",
      "database_id": "132c4026-f24c-4cdb-8245-8ed929376a16"
    }
  ]
}