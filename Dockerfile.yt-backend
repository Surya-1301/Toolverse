
FROM node:22-slim

ARG CACHE_DATE=2026-10-28-02

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ffmpeg ca-certificates python3 \
  && (apt-get install -y --no-install-recommends quickjs || true) \
  && ln -sf /usr/local/bin/node /usr/bin/node \
  && ln -sf /usr/local/bin/node /usr/bin/nodejs \
  && rm -rf /var/lib/apt/lists/* \
  && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
       -o /usr/local/bin/yt-dlp \
  && chmod +x /usr/local/bin/yt-dlp \
  && yt-dlp --version

WORKDIR /app
COPY download-server/yt-backend/package*.json ./
RUN npm install --omit=dev
COPY download-server/yt-backend/server.js ./


EXPOSE 3000
CMD ["node", "server.js"]
