t/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-slate-950 text-slate-100 antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-screen flex-col\"><header class=\"sticky top-0 z-50 border-b border-white/10 bg-slate-950/75 backdrop-blur-xl\"><div class=\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex h-16 items-center justify-between gap-3\"><a class=\"flex min-w-0 items-center gap-2 font-bold sm:gap-3\" href=\"/\"><span class=\"relative h-10 w-10 overflow-hidden rounded-xl bg-white\"><img alt=\"ToolverseX logo\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain p-1\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Flogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Flogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Flogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Flogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Flogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Flogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Flogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Flogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Flogo.png&amp;w=3840&amp;q=75\"/></span><span class=\"truncate text-base sm:text-lg\">ToolverseX</span></a><nav class=\"hidden items-center gap-1 text-sm text-slate-300 md:flex\"><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/json-formatter\">JSON</a><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/qr-generator\">QR</a><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/image-compressor\">Compress</a><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/paste\">Paste</a><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/url-shortener\">Shorten</a><a class=\"rounded-lg px-3 py-2 hover:bg-white/10 hover:text-white\" href=\"/file-share\">Upload</a></nav><button type=\"button\" class=\"inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-slate-200 transition hover:bg-white/10 md:hidden\" aria-expanded=\"false\" aria-label=\"Open navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></header><main class=\"flex-1\"><div class=\"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16\"><div class=\"mx-auto max-w-5xl\"><div class=\"rounded-3xl border border-red-500/20 bg-gradient-to-b from-red-500/[0.08] to-white/[0.025] p-6 shadow-2xl shadow-black/10 sm:p-8\"><div class=\"flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between\"><div><p class=\"mb-4 inline-flex rounded-full border border-red-400/20 bg-red-500/10 px-3 py-1 text-sm font-medium text-red-200\">Safety</p><h1 class=\"text-4xl font-bold tracking-tight text-white sm:text-6xl\">Report Abuse</h1><p class=\"mt-4 max-w-2xl text-base leading-8 text-slate-400\">Use this page to report harmful, illegal, deceptive, abusive, or unsafe content hosted or shared through ToolverseX.</p></div><div class=\"rounded-2xl border border-red-400/20 bg-slate-950/60 p-4 text-sm leading-6 text-slate-400 lg:max-w-sm\">If someone is in immediate danger, contact local emergency services or the appropriate authorities first.</div></div><div class=\"mt-8 grid gap-4 md:grid-cols-3\"><div class=\"rounded-2xl border border-red-400/20 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-red-500/15 text-red-300 ring-1 ring-red-400/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-siren h-5 w-5\" aria-hidden=\"true\"><path d=\"M7 18v-6a5 5 0 1 1 10 0v6\"></path><path d=\"M5 21a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2z\"></path><path d=\"M21 12h1\"></path><path d=\"M18.5 4.5 18 5\"></path><path d=\"M2 12h1\"></path><path d=\"M12 2v1\"></path><path d=\"m4.929 4.929.707.707\"></path><path d=\"M12 12v6\"></path></svg></div><h2 class=\"text-sm font-semibold text-white\">Urgent reports</h2><p class=\"mt-2 text-sm leading-6 text-slate-400\">Flag phishing, malware, exposed private data, or illegal content as clearly as possible.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-violet-600/15 text-violet-300 ring-1 ring-violet-400/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flag h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528\"></path></svg></div><h2 class=\"text-sm font-semibold text-white\">Include the link</h2><p class=\"mt-2 text-sm leading-6 text-slate-400\">Reports are easier to review when they include the exact ToolverseX URL or content ID.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-violet-600/15 text-violet-300 ring-1 ring-violet-400/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h2 class=\"text-sm font-semibold text-white\">Reviewed carefully</h2><p class=\"mt-2 text-sm leading-6 text-slate-400\">We may review reported links, metadata, and technical signals to protect users and the service.</p></div></div></div><section class=\"mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-7\"><div class=\"mb-5 flex items-center gap-3\"><div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/[0.04] text-red-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flag h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528\"></path></svg></div><h2 class=\"text-xl font-semibold tracking-tight text-white\">What you can report</h2></div><div class=\"grid gap-4 md:grid-cols-2\"><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-alert h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"M12 8v4\"></path><path d=\"M12 16h.01\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Phishing or scams</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Links or files pretending to be another service, stealing credentials, or misleading users.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bug h-5 w-5\" aria-hidden=\"true\"><path d=\"M12 20v-9\"></path><path d=\"M14 7a4 4 0 0 1 4 4v3a6 6 0 0 1-12 0v-3a4 4 0 0 1 4-4z\"></path><path d=\"M14.12 3.88 16 2\"></path><path d=\"M21 21a4 4 0 0 0-3.81-4\"></path><path d=\"M21 5a4 4 0 0 1-3.55 3.97\"></path><path d=\"M22 13h-4\"></path><path d=\"M3 21a4 4 0 0 1 3.81-4\"></path><path d=\"M3 5a4 4 0 0 0 3.55 3.97\"></path><path d=\"M6 13H2\"></path><path d=\"m8 2 1.88 1.88\"></path><path d=\"M9 7.13V6a3 3 0 1 1 6 0v1.13\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Malware or harmful files</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Downloads, scripts, documents, or links that may harm devices, systems, or users.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-ban h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M4.929 4.929 19.07 19.071\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Illegal or harmful content</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Content that appears illegal, dangerous, abusive, exploitative, or otherwise harmful.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock-keyhole h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"16\" r=\"1\"></circle><rect x=\"3\" y=\"10\" width=\"18\" height=\"12\" rx=\"2\"></rect><path d=\"M7 10V7a5 5 0 0 1 10 0v3\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Private information</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Content exposing personal data, credentials, private documents, or sensitive information.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-copyright h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M14.83 14.83a4 4 0 1 1 0-5.66\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Copyright or ownership</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Content that appears to infringe copyrights, trademarks, or ownership rights.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye h-5 w-5\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><h3 class=\"text-base font-semibold text-white\">Impersonation or deception</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Content misrepresenting identity, affiliation, source, or intent.</p></div></div></section><section class=\"mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-7\"><div class=\"mb-5 flex items-center gap-3\"><div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-exclamation-point h-5 w-5\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg></div><h2 class=\"text-xl font-semibold tracking-tight text-white\">What to include</h2></div><div class=\"grid gap-4 md:grid-cols-3\"><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-exclamation-point h-5 w-5\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">The ToolverseX link</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Include the full URL or file ID for the paste, upload, hosted file, image, or shortened link.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert h-5 w-5\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Reason for the report</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Explain what is wrong, why it is harmful, and whether immediate action is needed.</p></div><div class=\"rounded-2xl border border-white/10 bg-slate-950/50 p-4\"><div class=\"mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.04] text-violet-300 ring-1 ring-white/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"text-base font-semibold text-white\">Supporting context</h3><p class=\"mt-2 text-sm leading-6 text-slate-400\">Include screenshots, ownership details, legal context, or other evidence when available.</p></div></div></section><section class=\"mt-8 rounded-3xl border border-red-500/20 bg-red-500/10 p-6 text-sm leading-6 text-red-100\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert mt-0.5 h-5 w-5 shrink-0 text-red-300\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><div><p class=\"font-semibold text-white\">Important</p><p class=\"mt-2 text-red-100/80\">Report Abuse is for harmful, unsafe, illegal, or policy-violating content. For general questions or product feedback, use the Contact page instead.</p><div class=\"mt-4 flex flex-wrap gap-3\"><a class=\"inline-flex items-center gap-2 rounded-xl border border-red-300/20 px-4 py-2.5 text-sm font-semibold text-red-100 transition hover:bg-red-500/10\" href=\"/contact\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-4 w-4\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>Contact support</a><a href=\"mailto:abuse@toolversex.com\" class=\"inline-flex items-center gap-2 rounded-xl bg-red-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"ro